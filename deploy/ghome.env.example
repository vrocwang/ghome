# ghome — service configuration
#
#   sudo mkdir -p /etc/ghome
#   sudo cp deploy/ghome.env.example /etc/ghome/ghome.env
#   sudo chmod 600 /etc/ghome/ghome.env
#   sudo editor /etc/ghome/ghome.env
#
# Docker users: the same file is what `docker-compose.example.yml` reads as
# `env_file`, so fill it in once and both deployments work.
#
# Naming: every setting is the corresponding flag, uppercased and prefixed.
#   --poll  ->  GHOME_POLL
# A value here beats the built-in default; an explicit flag on the command line
# beats the environment. The one-shot flags (--healthcheck, --dump-web,
# --version) have no variable here, because they are actions rather than
# settings: run them as arguments.
#
# Nothing below is required except the source block: everything else has a
# sensible default or disables a feature when left empty.

# ------------------------------------------------------------------ serving
# Drop the GHOME_ prefix and lowercase to get the flag: --listen, --base-path,
# --log-level.
GHOME_LISTEN=127.0.0.1:8080
GHOME_LOG_LEVEL=info

# Set this if a reverse proxy exposes ghome under a sub-path, for example /nav.
# The webhook URL becomes https://your-host/nav/api/webhook.
# GHOME_BASE_PATH=/nav

# ------------------------------------------------------------------ source
# Where nav.yaml comes from.
#
#   forgejo / gitea  read it through the forge API. Same code either way; the
#                    value only decides the label shown in /healthz and logs.
#   file             read it off disk, for when something else already syncs the
#                    repository (a cron git pull, CI, rsync).
GHOME_SOURCE=forgejo

# ------------------------------------------------------------------ forge API
# Used when GHOME_SOURCE is forgejo or gitea.
GHOME_FORGE_URL=https://git.example.com
GHOME_FORGE_OWNER=your-name
GHOME_FORGE_REPO=homepage
GHOME_FORGE_REF=main
GHOME_FORGE_PATH=nav.yaml

# A read-only token, sent as "Authorization: Bearer ..." which both Gitea and
# Forgejo accept. Create it under Settings -> Applications -> Generate New
# Token with a read-only repository scope (read:repository; "repo" also works,
# ghome only ever reads).
#
# Required for a private repository. Never commit this, and never put it in a
# URL.
GHOME_FORGE_TOKEN=replace-me

# ------------------------------------------------------------------ local file
# Used when GHOME_SOURCE is file. The path must be absolute, or relative to the
# process working directory (--web-dir and --icon-dir are resolved the same way).
# GHOME_FILE=/srv/nav/nav.yaml

# ------------------------------------------------------------------ updates
# The safety net: re-check on a timer even if a webhook is missed. A silent
# webhook failure is the hardest kind to notice, which is why this exists.
#
# 0 switches polling off entirely: the config then loads once at startup and
# changes only on a webhook push or a manual refresh. That saves a request per
# interval, and it is the right setting if you would rather have a page that
# cannot go stale-looking than one that heals itself. The cost is that a broken
# webhook is no longer papered over.
GHOME_POLL=60s

# The fast path. Put the same string in the repository webhook and a push shows
# up in the browser within about a second. Leaving it empty disables
# /api/webhook entirely rather than exposing an unauthenticated write endpoint.
#   openssl rand -hex 32
GHOME_WEBHOOK_SECRET=replace-me

# Only reload for pushes to this branch. Defaults to GHOME_FORGE_REF. Ignored
# automatically when GHOME_FORGE_REF is a full commit SHA, since then any
# branch could change what is read.
# GHOME_BRANCH=main

# ------------------------------------------------------------------ state
# Persist the last good config, so a restart while the forge is unreachable
# still serves the last good page. In Docker this belongs on a volume; the
# image has /data for exactly that.
GHOME_CACHE_FILE=/var/lib/ghome/cache.yaml

# ------------------------------------------------------------------ styling
# Restyling is a data change, not a code change. Colours, radii, density and
# fonts live in the nav.yaml `style:` block, and a stylesheet named by
# `style.customCss` in the same repository is appended to /theme.css. Both ride
# the normal push-to-update path, so neither needs anything here.
#
# Only reach for --web-dir to change the markup or the base stylesheet. Start
# from a real copy rather than guessing the layout:
#   ghome --dump-web=/srv/ghome/web
# Files present in that directory win; anything missing still comes from the
# binary, so an upgrade keeps updating everything you did not override.
# GHOME_WEB_DIR=/srv/ghome/web

# Local icons, tried before fetching a site. Name files <host>.svg/.png/.ico/
# .webp/.jpg -- the reliable fix for internal services that have no favicon and
# for hosts that do not resolve. Read access is enough.
# GHOME_ICON_DIR=/var/lib/ghome/icons

# Whether ghome may fetch a site's icon over the network when a host has no
# local file. "auto" (the default) fetches; "off" never does, so the server
# makes no outbound icon requests at all and every link without a local file
# falls back to the letter avatar the UI generates from the link name. Use it
# on an air-gapped or metered box; pair it with GHOME_ICON_DIR for real icons.
# A value other than auto/off is a startup error rather than a silent "auto".
# GHOME_ICON_FETCH=auto

# ------------------------------------------------------------------ admin
# Optional. When set, a manual reload can be forced, which is handy after a
# cron `git pull` in file mode:
#   curl -X POST -H "Authorization: Bearer $GHOME_ADMIN_TOKEN" \
#        http://127.0.0.1:8080/api/refresh
# An empty value disables the endpoint.
# GHOME_ADMIN_TOKEN=
