# ghome — service configuration
#
#   sudo mkdir -p /etc/ghome
#   sudo cp deploy/ghome.env.example /etc/ghome/ghome.env
#   sudo chmod 600 /etc/ghome/ghome.env
#   sudo editor /etc/ghome/ghome.env
#
# Every setting here maps to a command line flag of the same name:
#   GHOME_POLL  ->  --poll
# Values in the environment win over the built-in default, but an explicit
# flag on the command line wins over the environment.

# Where to listen. Keep it on loopback and put nginx in front, so TLS and
# access control stay in one place.
GHOME_LISTEN=127.0.0.1:8080

# ------------------------------------------------------------------ source
# "gitea" and "forgejo" both read the file through the same API (Forgejo is a
# Gitea fork and serves the same /api/v1/repos/... shape); the only difference
# is the label shown in /healthz and the logs. "file" reads it off disk.
GHOME_SOURCE=forgejo
GHOME_FORGE_URL=https://git.example.com
GHOME_FORGE_OWNER=simon
GHOME_FORGE_REPO=homepage
GHOME_FORGE_REF=main
GHOME_FORGE_PATH=nav.yaml

# A read-only token, sent as "Authorization: Bearer ..." which both products
# accept. Settings -> Applications -> Generate New Token, read-only repository
# scope (read:repository; "repo" also works, ghome only ever reads).
# Never commit this, and never put it in a URL.
#
# ------------------------------------------------------------------ updates
# The safety net: re-check every minute even if a webhook is missed.
GHOME_POLL=60s

# The fast path: set the same string in the Gitea webhook, then a push shows up
# in the browser within a second.
#   openssl rand -hex 32
GHOME_WEBHOOK_SECRET=replace-me

# Optional. When set, `curl -X POST -H "Authorization: Bearer $TOKEN" .../api/refresh`
# forces a reload. An empty value disables the endpoint.
# GHOME_ADMIN_TOKEN=

# ------------------------------------------------------------------ serving
# Set this if nginx exposes ghome under a sub-path, for example /nav.
# GHOME_BASE_PATH=

# Persist the last good config so a restart survives a Gitea outage.
GHOME_CACHE_FILE=/var/lib/ghome/cache.yaml

# ------------------------------------------------------------------ styling
# Restyling is a data change, not a code change. Both of these are optional:
#
#   * Colours, radii, density and fonts live in the nav.yaml `style:` block.
#   * A stylesheet in the config repository, named by `style.customCss`, is
#     appended to /theme.css.
#
# Only reach for --web-dir if you need to change the markup or the base
# stylesheet. Start from a real copy instead of guessing the layout:
#   ghome --dump-web=/srv/ghome/web
# Files left in that directory win; anything missing still comes from the
# binary, so an upgrade keeps updating everything you did not override.
# GHOME_WEB_DIR=/srv/ghome/web

# Local icons, tried before fetching a site. Name files <host>.png/.svg/.ico,
# which is the reliable fix for internal services that have no favicon.
# GHOME_ICON_DIR=/var/lib/ghome/icons

# debug | info | warn | error
GHOME_LOG_LEVEL=info
