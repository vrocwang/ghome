# ghome behind nginx, with TLS.
#
# The two things that matter here are the SSE settings: without
# proxy_buffering off, /api/events arrives in clumps and live updates feel
# broken rather than just slow.

upstream ghome {
    server 127.0.0.1:8080;
    keepalive 8;
}

server {
    listen 443 ssl;
    http2 on;
    server_name nav.example.com;

    ssl_certificate     /etc/letsencrypt/live/nav.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nav.example.com/privkey.pem;

    # Optional: put a password on the UI.
    #
    # The browser answers the prompt once and then reuses the credentials for
    # everything the page loads, including the live-update stream, so the UI and
    # instant updates keep working. Verified against a real reverse proxy: one
    # auth challenge for the whole page load, live update in 1.5s, no reload.
    #
    # auth_basic           "ghome";
    # auth_basic_user_file /etc/nginx/ghome.htpasswd;

    # Optional: keep an internal tool off the public internet.
    # allow 10.0.0.0/8;
    # allow 192.168.0.0/16;
    # deny all;

    # Mounted at the site root. For a sub-path instead, use
    #   location /nav/ { proxy_pass http://ghome/; ... }
    # and start ghome with --base-path=/nav only if you are NOT stripping the
    # prefix here; with proxy_pass ending in "/" nginx strips it for you.
    location / {
        proxy_pass http://ghome;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # --- required for the live update stream ---
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        chunked_transfer_encoding on;
    }

    # The webhook must NOT sit behind auth_basic.
    #
    # The forge cannot answer an interactive password prompt, so a protected
    # /api/webhook answers 401 to Gitea/Forgejo and the instant update path dies
    # -- silently, because polling still updates the page, just up to a minute
    # later. The HMAC secret is what actually authenticates this endpoint; a bad
    # signature is still rejected by ghome with 401.
    #
    # Only needed if you enabled auth_basic above (auth_basic inherits into
    # nested locations, so it has to be turned off explicitly).
    location = /api/webhook {
        auth_basic off;

        # A better second layer than a password the forge cannot send: restrict
        # by source, if your forge has a stable address.
        # allow 10.0.0.5;
        # deny all;

        proxy_pass http://ghome;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    # If you use the private tier (private: true in nav.yaml), these two need
    # auth_basic off as well.
    #
    # The unlock token travels in "Authorization: Bearer", and nginx Basic
    # claims that same header -- the proxy answers 401 before ghome ever sees
    # the token, so the padlock can never open. Unlike /api/refresh there is no
    # second header to fall back to. What protects these endpoints is the forge
    # permission check ghome performs per token; an anonymous request simply
    # gets the public tier, and a withheld host still answers 404.
    location = /api/nav {
        auth_basic off;

        proxy_pass http://ghome;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    location = /api/status {
        auth_basic off;

        proxy_pass http://ghome;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}
